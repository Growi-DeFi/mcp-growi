# Custom RPC endpoint for Arbitrum (Alchemy, Infura, etc.)
# If not set, uses the default public Arbitrum RPC.
# RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: wallet signing configuration for execute_transaction tool.
# Set ONE of the following. If neither is set, execute_transaction is not available.
# PRIVATE_KEY takes precedence over KEYSTORE_PATH if both are set.
#
# Option A — raw private key directly in env (simpler, less secure):
# PRIVATE_KEY=0x...
#
# Option B — plain JSON keystore file (a bit more secure):
# File format: { "privateKey": "0x..." } — set permissions to 600 (chmod 600 /path/to/wallet.json)
# KEYSTORE_PATH=/path/to/wallet.json
#
# Option C — encrypted Ethereum keystore (RECOMMENDED) (most secure):
# Export private key from Wallet and generate keystore (helper present in scripts/create-keystore.mjs)
# KEYSTORE_PATH=/path/to/keystore.json
# KEYSTORE_PASSPHRASE=your_passphrase
